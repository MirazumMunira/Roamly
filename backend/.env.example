DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/roamly
CORS_ORIGINS=http://localhost:5173

# OpenStreetMap public-service endpoints. No key or billing account is required.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
OSM_USER_AGENT=Roamly/0.1 (local development contact: developer@example.com)

# Gemini is primary for chat and embeddings; OpenRouter is optional chat fallback.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenRouter-compatible chat provider. Keep this server-only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=Roamly

# Reality Layer RAG embeddings. The pgvector column dimension must match this model.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Weather uses Open-Meteo by default (no client-side key required).
WEATHER_PROVIDER=open_meteo
