DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/roamly
CORS_ORIGINS=http://localhost:5173

# OpenStreetMap provider endpoints. No API key, Google Cloud account, or billing is needed.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
OSM_USER_AGENT=Roamly/0.1 (local development contact: developer@example.com)

# Configure AI values in backend/.env, never in the browser.
# Gemini is primary; OpenRouter is an optional fallback.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
